# Copy to .env.production. This file must never contain a plaintext password.
ROTOSTREAM_AUTH_USER=editor
# Generate interactively: docker run --rm -it caddy:2.10-alpine caddy hash-password
# Single quotes preserve the dollar signs in a bcrypt hash for Docker Compose.
ROTOSTREAM_AUTH_HASH='paste-bcrypt-hash-here'
ROTOSTREAM_BIND_ADDRESS=127.0.0.1
ROTOSTREAM_GATEWAY_PORT=8080
ROTOSTREAM_MAX_UPLOAD_MB=512
ROTOSTREAM_MAX_FRAMES=900
ROTOSTREAM_LONG_SIDE=720

