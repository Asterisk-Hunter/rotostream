# Copy to `.env` and adjust. All API settings use the ROTOSTREAM_ prefix.

# Where uploads, extracted frames, masks and exports are written.
ROTOSTREAM_WORKSPACE_DIR=workspace

# Which registered tracker the API uses unless a request overrides it.
ROTOSTREAM_DEFAULT_MODEL=naive

# "auto" | "cuda" | "cpu"
ROTOSTREAM_DEVICE=auto

# Frame extraction budget. Frames are downscaled so the long side is <= LONG_SIDE.
ROTOSTREAM_LONG_SIDE=720
ROTOSTREAM_MAX_FRAMES=900
ROTOSTREAM_JPEG_QUALITY=92

# Bound queued/running jobs, terminal history, cached trackers and subprocess time.
ROTOSTREAM_MAX_PENDING_JOBS=16
ROTOSTREAM_JOB_HISTORY=200
ROTOSTREAM_PREVIEW_CACHE_SIZE=1
ROTOSTREAM_FFMPEG_TIMEOUT_S=600
# Maximum source frame area (default 8K), checked before extraction.
ROTOSTREAM_MAX_SOURCE_PIXELS=33177600

# Uploads larger than this are rejected.
ROTOSTREAM_MAX_UPLOAD_MB=512
ROTOSTREAM_ALLOWED_EXTENSIONS=.mp4,.mov,.m4v,.webm,.mkv,.avi

# Comma-separated extra trackers, e.g. "sam2_memory=mypkg.tracker:MyTracker".
# Useful for developing your model outside this repo.
ROTOSTREAM_MODELS=

# --- http ---
# 8010 by default, not 8000: 8000 is a common dev port and a collision otherwise
# surfaces as a confusing 404 from whichever app got there first.
ROTOSTREAM_HOST=127.0.0.1
ROTOSTREAM_PORT=8010

# CORS origins for the web app.
ROTOSTREAM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Web app ---
# Must match ROTOSTREAM_HOST:ROTOSTREAM_PORT above. Set this in web/.env.local if
# you change the API port; web/src/lib/api.ts falls back to http://127.0.0.1:8010.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010
