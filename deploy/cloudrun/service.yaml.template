apiVersion: serving.knative.dev/v1
kind: Service
metadata:
  name: rotostream
  annotations:
    run.googleapis.com/launch-stage: BETA
    run.googleapis.com/invoker-iam-disabled: "true"
    run.googleapis.com/maxScale: "1"
  labels:
    cloud.googleapis.com/location: __REGION__
spec:
  template:
    metadata:
      annotations:
        autoscaling.knative.dev/maxScale: "1"
        run.googleapis.com/secrets: 'rotostream-gateway-hash:projects/__PROJECT_NUMBER__/secrets/rotostream-gateway-hash'
        run.googleapis.com/execution-environment: gen2
        run.googleapis.com/container-dependencies: '{"web":["api"],"gateway":["api","web"]}'
    spec:
      serviceAccountName: __SERVICE_ACCOUNT__
      containerConcurrency: 40
      timeoutSeconds: 3600
      containers:
      - name: api
        image: __API_IMAGE__
        env:
        - name: ROTOSTREAM_WORKSPACE_DIR
          value: /workspace
        - name: ROTOSTREAM_DEVICE
          value: cpu
        - name: ROTOSTREAM_DEFAULT_MODEL
          value: naive
        - name: ROTOSTREAM_MAX_UPLOAD_MB
          value: "512"
        - name: ROTOSTREAM_MAX_FRAMES
          value: "900"
        - name: ROTOSTREAM_LONG_SIDE
          value: "720"
        - name: ROTOSTREAM_CORS_ORIGINS
          value: ""
        resources:
          limits:
            cpu: "4"
            memory: 8Gi
        startupProbe:
          httpGet:
            path: /api/ready
            port: 8010
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 12
        volumeMounts:
        - name: workspace
          mountPath: /workspace
      - name: web
        image: __WEB_IMAGE__
        resources:
          limits:
            cpu: "1"
            memory: 512Mi
        startupProbe:
          httpGet:
            path: /
            port: 3000
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 12
      - name: gateway
        image: __GATEWAY_IMAGE__
        ports:
        - name: http1
          containerPort: 8080
        env:
        - name: ROTOSTREAM_AUTH_USER
          value: editor
        - name: ROTOSTREAM_AUTH_HASH
          valueFrom:
            secretKeyRef:
              name: rotostream-gateway-hash
              key: "__AUTH_SECRET_VERSION__"
        resources:
          limits:
            cpu: "1"
            memory: 256Mi
        startupProbe:
          tcpSocket:
            port: 8080
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 12
      volumes:
      - name: workspace
        csi:
          driver: gcsfuse.run.googleapis.com
          readOnly: false
          volumeAttributes:
            bucketName: __BUCKET_NAME__
            mountOptions: uid=10001,gid=10001,file-mode=0660,dir-mode=0770
