{
  "name": "rotostream",
  "version": "0.1.0",
  "private": true,
  "description": "AI rotoscoping studio - Next.js + FastAPI shell around a pluggable video object tracker",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "node scripts/dev.mjs --api-only",
    "dev:web": "node scripts/dev.mjs --web-only",
    "build": "pnpm --dir web build",
    "start": "pnpm --dir web start",
    "lint": "pnpm --dir web lint",
    "typecheck": "pnpm --dir web typecheck",
    "test:web": "pnpm --dir web test",
    "test:api": "node scripts/python.mjs -m pytest api/tests -q",
    "test:ml": "node scripts/python.mjs -m pytest ml/tests -q",
    "test": "node scripts/python.mjs -m pytest api/tests ml/tests -q",
    "check:model": "node scripts/python.mjs api/scripts/check_model.py",
    "smoke": "node scripts/python.mjs api/scripts/smoke.py",
    "demo": "node scripts/python.mjs scripts/make_demo.py",
    "verify": "pnpm lint && pnpm typecheck && pnpm test:web && pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=22.6"
  },
  "packageManager": "pnpm@10.4.1",
  "pnpm": {
    "overrides": {
      "source-map-js": "^1.2.2"
    }
  }
}
