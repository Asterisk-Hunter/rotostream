# Copy to `web/.env.local` and adjust.
#
# The API base URL. Must match ROTOSTREAM_HOST:ROTOSTREAM_PORT in the root
# `.env.example` - 8010, not 8000. `web/src/lib/api.ts` falls back to this value
# when the variable is unset, so setting it is only necessary when the API runs
# somewhere else.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010
